# Flask app
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key

# Server
HOST=0.0.0.0
PORT=5000

# Backend API (JosRide-back)
# Local dev: run JosRide-back with `python run.py` (port 8000)
# DEPLOYED_API_URL is tried automatically when local is unavailable.
API_URL=http://localhost:8000
DEPLOYED_API_URL=https://jcride-back.onrender.com
# Or list both explicitly (comma-separated, tried in order):
# API_URL=http://localhost:8000,https://jcride-back.onrender.com
# HTTP timeout in seconds for backend requests (Render cold starts need 60–90+)
API_TIMEOUT=90

# Optional: force invite/share links to this origin (e.g. https://app.josride.ng)
# If unset, links use the current request host (recommended for custom domains).
# PUBLIC_APP_URL=https://your-domain.com

# Support / emergency phones shown on /user/support (match mobile EXPO_PUBLIC_*)
DRIVER_SUPPORT_PHONE=+2348012345678
EMERGENCY_PHONE=112

# Google Maps JS (book ride, live tracking, driver trip, admin live map)
# Must be EXPO_PUBLIC_GOOGLE_MAPS_API_KEY (same as mobile). Empty → Leaflet fallback.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Website live-tracking simulation (JCRide-front reads THIS file, not JCRide-back/.env)
# Enables skip-finding + “Simulate delivery completed” on /user/live-tracking.
# Keep 0 / unset in production. Restart Flask after changing.
SIMULATE_DELIVERY_COMPLETED=0
EXPO_PUBLIC_SKIP_DRIVER_MATCH=0
