# Flask app
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key

# Server
HOST=0.0.0.0
PORT=5000

# Backend API (JCRide-back)
# Local dev: run JCRide-back with `python run.py` (port 8000)
# Production: https://jcride-back.onrender.com (free tier may cold-start slowly)
API_URL=http://localhost:8000
# HTTP timeout in seconds for backend requests (Render cold starts need 60–90+)
API_TIMEOUT=90
